X(ADSB_EMERGENCY,                   0,                "an aircraft's emergency squawk: about the aircraft, not the site")
X(KARMA_PROBE_FORGE,                QM(Q1),           "")
X(PMKID_HARVEST,                    QM(Q3),           "")
X(HANDSHAKE_HARVEST,                QM(Q3),           "")
X(SENSOR_UNDERVOLT,                 QM(Q7),           "")
X(SENSOR_SOURCE_DOWN,               QM(Q7),           "")
X(SENSOR_SUPPRESSED,                QM(Q7),           "")
