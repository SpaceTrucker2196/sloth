ntop
ntop_test
/sloth
sloth_test
# The capture-path suite's binary (#95), merged into sloth_test by #116;
# still ignored so a tree built before that does not list it.
sloth_test_pcap
# The link-only no-flag suite (#116, `make sloth_test_noflags`).
sloth_test_noflags
# Release-binary backups kept beside the tree. Untracked and binary,
# so risk_score.sh counted them as pending adds until they were ignored.
sloth.bak-*
*.o
# Per-configuration object directories, archives and fuzz binaries (#115).
/build/
*.dSYM/
__pycache__/
.DS_Store

# Build artifact for the research corpus (#73). research.db itself
# IS committed — see the note on the research-index target.
research_ingest

# The MCP server (#73). Built on demand via `make research-mcp`; not
# part of `all`, because the monitor links the query layer directly.
sloth-research-mcp

# slothweb (#157). Built on demand via `make web` / `make web-test`.
/slothweb
/slothweb_test


# libFuzzer writes its reproducers into the working directory, so a
# `make fuzz` that finds something leaves crash-/leak-/timeout- files
# at the repo root. They are evidence, not source: keep the bytes, move
# them under tests/fuzz/corpus/ with a note if they are worth keeping,
# and never let one reach a commit.
crash-*
leak-*
timeout-*
oom-*

# Agent worktrees (Claude Code `isolation: worktree`). Nested git
# worktrees under the repo; risk_score.sh skips them, but they must not
# be stageable either.
.claude/worktrees/

# The live capture output directory: per-alert pcaps, the sqlite DB and
# its side files, --report output, and the gated EAPOL handshake exports.
# #87 makes sloth create it root-owned 0700, so git usually cannot even
# read it — and that is the ONLY reason it has never been staged. It was
# not actually ignored: `git check-ignore data/sloth.db` returned
# not-ignored, and the apparent match on `data/` was git reporting a path
# it could not stat. One permissions change, or one run as the invoking
# user, and crackable material becomes stageable. Hence an explicit rule.
data/

# slothweb's vendor table inputs (#162): the IEEE registry CSVs in
# web/data/ ARE committed (owner ruling 2026-10-26, reversing the
# 2026-10-21 one that kept them out; web/data/SOURCE.md). The data/ rule
# above would match web/data/ too, so the directory is re-included and
# then emptied again, and only the five committed files are named back.
# Re-including the directory alone would re-include everything a sloth
# run with cwd=web/ writes there (sloth.db, alert pcaps, EAPOL exports),
# which is exactly what the data/ rule exists to stop.
# The table generated from them, build/web/web_oui_table.c, is build
# output and stays ignored under /build/ above.
!/web/data/
/web/data/*
!/web/data/oui.csv
!/web/data/mam.csv
!/web/data/oui36.csv
!/web/data/iab.csv
!/web/data/SOURCE.md
