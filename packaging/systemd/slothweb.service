# slothweb.service — the read-only web UI over the sensor (#153, #168).
#
# Installed by `sudo make install-service` to /etc/systemd/system, beside
# sloth-sensor.service; the binary is placed by `sudo make install`.
# `sloth-migrate-sensor --with-slothweb` installs, starts and verifies it
# after the sensor itself verifies. Recipe and the reason for every key:
# docs/wiki/deployment.md §6.
#
# Why it runs as sloth: the sensor's state is /var/lib/sloth, 0700 sloth,
# and its data socket /run/sloth/sloth.sock is 0600 sloth (src/
# data_socket.c, SO_PEERCRED). slothweb reads both, so it is the same
# account, not a second one granted access to them. It holds no
# capability: it binds a port above 1024 and never captures.

[Unit]
Description=slothweb read-only web UI for the sloth sensor
Documentation=https://github.com/SpaceTrucker2196/sloth/wiki/slothweb
Documentation=https://github.com/SpaceTrucker2196/sloth/wiki/deployment
# The stream and sloth.db are the sensor's. Wants=, not Requires=: a
# sensor restart (or its radio going away) must not take the UI down,
# which keeps serving the history and says the stream is retrying.
After=sloth-sensor.service
Wants=sloth-sensor.service

[Service]
Type=simple
User=sloth
Group=sloth

# Site configuration: /etc/default/slothweb. Environment= gives the
# default (no extra flags: loopback, 127.0.0.1:8770); the file, when
# present, overrides it. `make install-service` never replaces an
# existing copy.
Environment=SLOTHWEB_ARGS=
EnvironmentFile=-/etc/default/slothweb

# /var/lib/slothweb (0700) holds slothweb.db, the time series and the
# baselines: slothweb's own file, never sloth.db.
StateDirectory=slothweb
StateDirectoryMode=0700
WorkingDirectory=/var/lib/slothweb
UMask=0077

# The three paths are this deployment's, fixed here because the sandbox
# below admits no others: the sensor's unix socket, the sensor's db read
# in place (WAL reader, web/src/web_slothdb.h: no side file is ever made
# beside it), slothweb's own store. $SLOTHWEB_ARGS carries the bind and
# the allowed peers (packaging/default/slothweb).
ExecStart=/usr/local/bin/slothweb \
    --socket unix:/run/sloth/sloth.sock \
    --sloth-db /var/lib/sloth/sloth.db \
    --store /var/lib/slothweb/slothweb.db \
    $SLOTHWEB_ARGS

# ── Privilege ────────────────────────────────────────────────────────────
# None at all: both sets empty, so nothing can be gained by exec either.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# ── Filesystem ───────────────────────────────────────────────────────────
# Everything read-only but the state directory. /var/lib/sloth is
# read-only already under strict; ReadOnlyPaths= says so explicitly, so a
# later ReadWritePaths= cannot widen it by accident.
ProtectSystem=strict
ReadOnlyPaths=/var/lib/sloth
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible

# ── Kernel surface ───────────────────────────────────────────────────────
# AF_UNIX for the data socket; AF_INET and AF_INET6 because it serves
# HTTP. No netlink, no packet sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# ── Resources ────────────────────────────────────────────────────────────
# The store is capped on disk (--web-max-mb, 256 MB by default); memory
# is the rings, the page cache of two SQLite files and the HTTP buffers.
MemoryMax=512M
MemoryHigh=384M
TasksMax=32

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=slothweb

[Install]
WantedBy=multi-user.target
